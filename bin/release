#!/bin/sh
# 친구용 배포: bin/release
# 지금 커밋(HEAD)의 파일만 기록 없이 한 커밋으로 묶어 배포 저장소의 main 에 올린다.
# git 에 들어 있는 것만 나가므로 내 설정(config/*.yaml, profile.md, .env, data/)은 절대 안 나간다.
set -e
cd "$(dirname "$0")/.."
REPO=${PA_RELEASE_REPO:-https://github.com/Rhombusbork/personal_assistant_release.git}
[ -z "$(git status --porcelain)" ] || { echo "커밋 안 된 변경이 있습니다 — 먼저 커밋하세요"; exit 1; }
PERSONAL='neojun|학번은 [0-9]|[0-9]{10}_'  # 아이디, 학번 문장, 학번_이름 파일명
if git grep -qIiE "$PERSONAL" HEAD -- . ':!bin/release'; then
  echo "개인 정보로 보이는 줄이 있어 멈춥니다:"; git grep -nIiE "$PERSONAL" HEAD -- . ':!bin/release'; exit 1
fi
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
git archive HEAD | tar -x -C "$TMP"
rm -f "$TMP/bin/release"
cd "$TMP"
git init -q -b main
git add -A
git -c user.name="$(git -C "$OLDPWD" config user.name)" -c user.email="$(git -C "$OLDPWD" config user.email)" \
  commit -qm "Release $(date +%Y-%m-%d) ($(git -C "$OLDPWD" rev-parse --short HEAD))"
git push -q -f "$REPO" main
echo "올림: $REPO"
