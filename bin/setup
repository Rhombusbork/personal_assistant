#!/bin/sh
# 처음 설치: bin/setup  (여러 번 실행해도 안전 — 이미 있는 것은 건드리지 않음)
set -e
cd "$(dirname "$0")/.."

echo "== 1. 파이썬 환경 (.venv)"
[ -d .venv ] || python3 -m venv .venv
.venv/bin/pip install -q -r requirements.txt
.venv/bin/python -m playwright install chromium >/dev/null 2>&1 \
  && echo "   PDF·브라우저용 Chromium 준비됨" \
  || echo "   ⚠️ Chromium 설치 실패 — 나중에: .venv/bin/python -m playwright install --with-deps chromium"

echo "== 2. 개인 파일"
[ -f .env ] || { cp .env.example .env; echo "   .env 만듦 (CANVAS_TOKEN 을 채우세요)"; }
for f in config/*.example.*; do
  real="${f%.example.*}.${f##*.}"
  [ -f "$real" ] || { cp "$f" "$real"; echo "   $real 만듦 (견본 — 내 것으로 고치기)"; }
done
mkdir -p data

echo "== 3. 연결 폴더"
for d in ~/study_system/materials ~/study_system/notes ~/report; do
  [ -d "$d" ] || { mkdir -p "$d"; echo "   $d 만듦"; }
done

echo "== 4. 아직 남은 것"
missing=0
grep -q '^CANVAS_TOKEN=.\+' .env || { echo "   [ ] .env 에 CANVAS_TOKEN"; missing=1; }
[ -f credentials.json ] || { echo "   [ ] credentials.json (docs/google-calendar-setup.md)"; missing=1; }
grep -q '예시과목' config/timetable.yaml config/courses.yaml config/profile.md 2>/dev/null \
  && { echo "   [ ] config/timetable.yaml·courses.yaml·profile.md 의 '예시과목'을 내 시간표·과목으로"; missing=1; }
[ $missing = 0 ] && echo "== 준비 끝: bin/pa run --full" || echo "== 위를 채운 뒤: bin/pa run --full"
