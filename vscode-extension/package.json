{
  "name": "pa-dashboard",
  "displayName": "개인 비서 대시보드",
  "description": "비서 대시보드를 VSCode 안 탭(Simple Browser)으로 연다: 탭 줄 오른쪽 위 버튼 · 상태 줄 '비서' · Ctrl+Alt+D (저절로 열지 않음).",
  "version": "0.3.0",
  "publisher": "personal-assistant",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "extensionKind": ["ui"],
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [{ "command": "paDashboard.open", "title": "대시보드 열기", "category": "비서",
                   "icon": { "light": "icon.svg", "dark": "icon.svg" } }],
    "menus": {
      "editor/title": [{ "command": "paDashboard.open", "group": "navigation@100" }]
    },
    "keybindings": [{ "command": "paDashboard.open", "key": "ctrl+alt+d", "mac": "cmd+alt+d" }],
    "configuration": {
      "title": "개인 비서",
      "properties": {
        "paDashboard.url": { "type": "string", "default": "http://localhost:8765/", "description": "비서 대시보드 주소" }
      }
    }
  }
}
